# Every setting the frontend reads. README.md ("Settings") explains each.
# Nothing loads this file on its own (Next.js reads .env and .env.local, never .env.example): on
# roberto-server the pipeline injects ~/gmshield-ci/secrets/frontend.env, written by GMshield-pipeline
# deploy/data-credentials.sh. To run by hand, copy it to .env.local (git-ignored) and fill in the secret.
# For the whole application, use the shared development setup in GMshield-backend/dev instead.
# Secrets are left empty here and never committed.

# The backend's address, http or https (required outside test mode)
GMSHIELD_BACKEND_URL=http://gmshield-backend:8080

# The service credential, the same value as the backend's (required outside test mode; secret):
# 32 to 512 characters of A-Z a-z 0-9 . _ ~ + / = -
GMSHIELD_FRONTEND_CREDENTIAL=

# Unset, or `test` (set only by the pipeline; test mode refuses a real credential beside it)
# GMSHIELD_MODE=test

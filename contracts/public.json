{
  "components" : {
    "schemas" : {
      "Campaign" : {
        "properties" : {
          "id" : {
            "description" : "The campaign's id",
            "example" : "0190a0b0-0000-7000-8000-000000000002",
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "description" : "The campaign's name",
            "example" : "Primeira campanha",
            "type" : "string"
          },
          "system" : {
            "$ref" : "#/components/schemas/System",
            "description" : "The campaign's system"
          }
        },
        "required" : [ "id", "name", "system" ],
        "type" : "object"
      },
      "CompleteSignIn" : {
        "properties" : {
          "attemptToken" : {
            "description" : "The attempt token of the visitor's cookie",
            "type" : "string"
          },
          "language" : {
            "default" : "pt-BR",
            "description" : "The interface's language: the new account's first system and campaign are named in it. Optional, pt-BR when absent",
            "enum" : [ "pt-BR", "en" ],
            "example" : "pt-BR",
            "type" : "string"
          },
          "termsAccepted" : {
            "description" : "The visitor accepted the terms of use and the privacy notice",
            "type" : "boolean"
          },
          "username" : {
            "description" : "3 to 24 characters: letters a to z in upper or lower case, digits, \"_\", \".\" and \"-\"; unique whatever the case, shown as typed",
            "example" : "mestre_ana",
            "type" : "string"
          }
        },
        "required" : [ "attemptToken", "termsAccepted", "username" ],
        "type" : "object"
      },
      "ContractVersion" : {
        "properties" : {
          "version" : {
            "description" : "Version of the OpenAPI document",
            "example" : "1.0.0",
            "type" : "string"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "GoogleCallback" : {
        "properties" : {
          "attemptToken" : {
            "description" : "The attempt token of the visitor's cookie",
            "type" : "string"
          },
          "code" : {
            "description" : "The code parameter of Google's redirect",
            "type" : "string"
          },
          "error" : {
            "description" : "The error parameter of Google's redirect, when Google refused",
            "type" : "string"
          },
          "state" : {
            "description" : "The state parameter of Google's redirect",
            "type" : "string"
          }
        },
        "required" : [ "attemptToken" ],
        "type" : "object"
      },
      "Me" : {
        "properties" : {
          "username" : {
            "description" : "The username, as typed",
            "example" : "mestre_ana",
            "type" : "string"
          }
        },
        "required" : [ "username" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "Every error of this API (RFC 9457 problem detail).",
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "code" : {
            "description" : "category.reason",
            "type" : "string"
          },
          "params" : {
            "additionalProperties" : true,
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "description" : "urn:gmshield:problem: followed by the code",
            "type" : "string"
          }
        },
        "required" : [ "category", "code", "params", "status", "title", "traceId", "type" ],
        "type" : "object"
      },
      "SessionGrant" : {
        "properties" : {
          "expiresInSeconds" : {
            "description" : "What is left of the session's absolute lifetime",
            "example" : 604800,
            "format" : "int64",
            "type" : "integer"
          },
          "renewAfterSeconds" : {
            "description" : "After this many seconds the frontend renews the token (POST /api/v1/session/renewal)",
            "example" : 900,
            "format" : "int64",
            "type" : "integer"
          },
          "sessionToken" : {
            "description" : "The session token: the frontend keeps it in a cookie and sends it as X-Session-Token",
            "example" : "example-session-token",
            "type" : "string"
          }
        },
        "required" : [ "expiresInSeconds", "renewAfterSeconds", "sessionToken" ],
        "type" : "object"
      },
      "SignInOutcome" : {
        "properties" : {
          "outcome" : {
            "description" : "signed_in: a known account, with its session; username_required: a first sign-in, whose username step comes next",
            "enum" : [ "signed_in", "username_required" ],
            "example" : "signed_in",
            "type" : "string"
          },
          "session" : {
            "$ref" : "#/components/schemas/SessionGrant",
            "description" : "Present when signed in"
          }
        },
        "required" : [ "outcome" ],
        "type" : "object"
      },
      "SignInStarted" : {
        "properties" : {
          "attemptToken" : {
            "description" : "The attempt token: the frontend keeps it in a cookie and sends it with the callback",
            "example" : "example-attempt-token",
            "type" : "string"
          },
          "authorizationUrl" : {
            "description" : "Where the browser goes next: Google's authorization endpoint, or in test mode the frontend's own callback (a path)",
            "example" : "/auth/google/callback?state=example&code=stand-in.1.gm%40example.test",
            "type" : "string"
          },
          "expiresInSeconds" : {
            "description" : "Lifetime of the attempt",
            "example" : 600,
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "attemptToken", "authorizationUrl", "expiresInSeconds" ],
        "type" : "object"
      },
      "System" : {
        "properties" : {
          "id" : {
            "description" : "The system's id",
            "example" : "0190a0b0-0000-7000-8000-000000000001",
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "description" : "The system's name",
            "example" : "Sistema sem nome",
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "UploadCompletion" : {
        "properties" : {
          "materialId" : {
            "description" : "The material's id",
            "example" : "0190a0b0-0000-7000-8000-000000000003",
            "format" : "uuid",
            "type" : "string"
          },
          "state" : {
            "description" : "The version's state",
            "example" : "waiting",
            "type" : "string"
          },
          "versionId" : {
            "description" : "The version's id",
            "example" : "0190a0b0-0000-7000-8000-000000000004",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "materialId", "state", "versionId" ],
        "type" : "object"
      },
      "UploadCompletionRequest" : {
        "properties" : {
          "sha256" : {
            "description" : "The whole file's SHA-256, in hexadecimal",
            "example" : "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "pattern" : "^[0-9a-fA-F]{64}$",
            "type" : "string"
          }
        },
        "required" : [ "sha256" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "serviceCredential" : {
        "description" : "The frontend's service credential (GMSHIELD_FRONTEND_CREDENTIAL); without it every path answers service.unauthenticated (401)",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "GMshield public API",
    "version" : "1.4.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/campaigns/current" : {
      "get" : {
        "operationId" : "getCurrentCampaign",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Campaign"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "The current campaign with its system; session.required (401) without a session, request.not_found (404) when the account has no campaign",
        "tags" : [ "library" ]
      }
    },
    "/api/v1/campaigns/{id}" : {
      "get" : {
        "operationId" : "getCampaign",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The campaign's id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Campaign"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "One of the account's campaigns, with its system; request.not_found (404) for any other id",
        "tags" : [ "library" ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "getMe",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Session-Token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Me"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "The signed-in account; session.required (401) without a session, session.renewal_required (401) when the token must be renewed first",
        "tags" : [ "session" ]
      }
    },
    "/api/v1/session" : {
      "delete" : {
        "operationId" : "endSession",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Session-Token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "The session is over"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Sign out: ends the session of the token, if it exists",
        "tags" : [ "session" ]
      }
    },
    "/api/v1/session/renewal" : {
      "post" : {
        "operationId" : "renewSession",
        "parameters" : [ {
          "in" : "header",
          "name" : "X-Session-Token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionGrant"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Renew the session: a new token, the presented one kept for the overlap. session.already_renewed (409) with the previous token within the overlap; session.required (401) when the session is over",
        "tags" : [ "session" ]
      }
    },
    "/api/v1/sign-in/complete" : {
      "post" : {
        "operationId" : "completeSignIn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CompleteSignIn"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionGrant"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "The username step of a first sign-in: creates the account and starts a session",
        "tags" : [ "sign-in" ]
      }
    },
    "/api/v1/sign-in/google" : {
      "post" : {
        "operationId" : "startGoogleSignIn",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SignInStarted"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Start a sign-in with Google: a 10-minute attempt",
        "tags" : [ "sign-in" ]
      }
    },
    "/api/v1/sign-in/google/callback" : {
      "post" : {
        "operationId" : "finishGoogleSignIn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GoogleCallback"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SignInOutcome"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Google's redirect, relayed with the attempt token: a session, or the username step next",
        "tags" : [ "sign-in" ]
      }
    },
    "/api/v1/systems/{id}" : {
      "get" : {
        "operationId" : "getSystem",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The system's id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/System"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "One of the account's game systems; request.not_found (404) for any other id",
        "tags" : [ "library" ]
      }
    },
    "/api/v1/uploads" : {
      "post" : {
        "operationId" : "createUpload",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The tus version",
          "in" : "header",
          "name" : "Tus-Resumable",
          "required" : true,
          "schema" : {
            "enum" : [ "1.0.0" ],
            "type" : "string"
          }
        }, {
          "description" : "The file's size in bytes, 1 to 2147483648",
          "in" : "header",
          "name" : "Upload-Length",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "maximum" : 2147483648,
            "minimum" : 1,
            "type" : "integer"
          }
        }, {
          "description" : "tus metadata: comma-separated keys, each with its value in Base64; filename is required",
          "in" : "header",
          "name" : "Upload-Metadata",
          "required" : true,
          "schema" : {
            "example" : "filename cnVsZXMucGRm",
            "type" : "string"
          }
        } ],
        "responses" : {
          "201" : {
            "description" : "Created",
            "headers" : {
              "Location" : {
                "description" : "The upload's path, relative",
                "required" : true,
                "schema" : {
                  "example" : "/api/v1/uploads/0190a0b0-0000-7000-8000-000000000005",
                  "type" : "string"
                },
                "style" : "simple"
              },
              "Tus-Resumable" : {
                "required" : true,
                "schema" : {
                  "example" : "1.0.0",
                  "type" : "string"
                },
                "style" : "simple"
              },
              "Upload-Expires" : {
                "description" : "When the upload expires (HTTP-date)",
                "required" : true,
                "schema" : {
                  "example" : "Tue, 17 Nov 2026 06:00:00 GMT",
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "tus 1.0.0 creation: a material, its version in uploading and an upload that expires after 6 hours. upload.too_large (413) outside 1 byte to 2 GiB; upload.metadata_invalid (400) without a valid filename; upload.tus_version (412) without Tus-Resumable: 1.0.0; session.required (401) without a session.",
        "tags" : [ "uploads" ]
      }
    },
    "/api/v1/uploads/{id}" : {
      "head" : {
        "operationId" : "getUploadOffset",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The tus version",
          "in" : "header",
          "name" : "Tus-Resumable",
          "required" : true,
          "schema" : {
            "enum" : [ "1.0.0" ],
            "type" : "string"
          }
        }, {
          "description" : "The upload's id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "headers" : {
              "Cache-Control" : {
                "required" : true,
                "schema" : {
                  "example" : "no-store",
                  "type" : "string"
                },
                "style" : "simple"
              },
              "Tus-Resumable" : {
                "required" : true,
                "schema" : {
                  "example" : "1.0.0",
                  "type" : "string"
                },
                "style" : "simple"
              },
              "Upload-Expires" : {
                "description" : "When the upload expires (HTTP-date)",
                "required" : true,
                "schema" : {
                  "example" : "Tue, 17 Nov 2026 06:00:00 GMT",
                  "type" : "string"
                },
                "style" : "simple"
              },
              "Upload-Length" : {
                "description" : "The file's size in bytes",
                "required" : true,
                "schema" : {
                  "example" : 2147483648,
                  "format" : "int64",
                  "type" : "integer"
                },
                "style" : "simple"
              },
              "Upload-Offset" : {
                "description" : "Bytes verified and stored",
                "required" : true,
                "schema" : {
                  "example" : 67108864,
                  "format" : "int64",
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "tus 1.0.0 offset: how many bytes are verified and stored. request.not_found (404) for any other id; upload.expired (410) after 6 hours; session.required (401) without a session.",
        "tags" : [ "uploads" ]
      },
      "patch" : {
        "operationId" : "patchUpload",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The tus version",
          "in" : "header",
          "name" : "Tus-Resumable",
          "required" : true,
          "schema" : {
            "enum" : [ "1.0.0" ],
            "type" : "string"
          }
        }, {
          "description" : "Where this part starts: the stored offset",
          "in" : "header",
          "name" : "Upload-Offset",
          "required" : true,
          "schema" : {
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "description" : "sha256 and the part's SHA-256 in Base64",
          "in" : "header",
          "name" : "Upload-Checksum",
          "required" : true,
          "schema" : {
            "example" : "sha256 47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=",
            "type" : "string"
          }
        }, {
          "description" : "The upload's id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/offset+octet-stream" : {
              "schema" : {
                "format" : "binary",
                "type" : "string"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "The part is verified and stored",
            "headers" : {
              "Tus-Resumable" : {
                "required" : true,
                "schema" : {
                  "example" : "1.0.0",

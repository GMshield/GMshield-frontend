{
  "components" : {
    "schemas" : {
      "Campaign" : {
        "properties" : {
          "id" : {
            "description" : "The campaign's id",
            "example" : "0190a0b0-0000-7000-8000-000000000002",
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "description" : "The campaign's name",
            "example" : "Primeira campanha",
            "type" : "string"
          },
          "system" : {
            "$ref" : "#/components/schemas/System",
            "description" : "The campaign's system"
          }
        },
        "required" : [ "id", "name", "system" ],
        "type" : "object"
      },
      "CompleteSignIn" : {
        "properties" : {
          "attemptToken" : {
            "description" : "The attempt token of the visitor's cookie",
            "type" : "string"
          },
          "language" : {
            "default" : "pt-BR",
            "description" : "The interface's language: the new account's first system and campaign are named in it. Optional, pt-BR when absent",
            "enum" : [ "pt-BR", "en" ],
            "example" : "pt-BR",
            "type" : "string"
          },
          "termsAccepted" : {
            "description" : "The visitor accepted the terms of use and the privacy notice",
            "type" : "boolean"
          },
          "username" : {
            "description" : "3 to 24 characters: letters a to z in upper or lower case, digits, \"_\", \".\" and \"-\"; unique whatever the case, shown as typed",
            "example" : "mestre_ana",
            "type" : "string"
          }
        },
        "required" : [ "attemptToken", "termsAccepted", "username" ],
        "type" : "object"
      },
      "ContractVersion" : {
        "properties" : {
          "version" : {
            "description" : "Version of the OpenAPI document",
            "example" : "1.0.0",
            "type" : "string"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "GoogleCallback" : {
        "properties" : {
          "attemptToken" : {
            "description" : "The attempt token of the visitor's cookie",
            "type" : "string"
          },
          "code" : {
            "description" : "The code parameter of Google's redirect",
            "type" : "string"
          },
          "error" : {
            "description" : "The error parameter of Google's redirect, when Google refused",
            "type" : "string"
          },
          "state" : {
            "description" : "The state parameter of Google's redirect",
            "type" : "string"
          }
        },
        "required" : [ "attemptToken" ],
        "type" : "object"
      },
      "Material" : {
        "properties" : {
          "failure" : {
            "description" : "Why the version failed (category.reason), only when the state is failed",
            "example" : "ingestion.password_required",
            "type" : "string"
          },
          "id" : {
            "description" : "The material's id",
            "example" : "0190a0b0-0000-7000-8000-000000000003",
            "format" : "uuid",
            "type" : "string"
          },
          "kind" : {
            "description" : "What the material is, when the GM said",
            "enum" : [ "rulebook", "supplement", "homebrew", "campaign_notes", "other" ],
            "example" : "rulebook",
            "type" : "string"
          },
          "name" : {
            "description" : "The material's name",
            "example" : "Livro do Jogador.pdf",
            "type" : "string"
          },
          "pages" : {
            "$ref" : "#/components/schemas/MaterialPages",
            "description" : "Pages done of the total, once the total is known"
          },
          "state" : {
            "description" : "The state of the material's newest version",
            "enum" : [ "uploading", "waiting", "processing", "needs_review", "ready", "superseded", "failed", "discarded" ],
            "example" : "waiting",
            "type" : "string"
          },
          "upload" : {
            "$ref" : "#/components/schemas/MaterialUpload",
            "description" : "The unfinished upload, only while the state is uploading"
          }
        },
        "required" : [ "id", "name", "state" ],
        "type" : "object"
      },
      "MaterialPage" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/Material"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "description" : "The cursor of the next page; absent on the last",
            "example" : "0190a0b0-0000-7000-8000-000000000003",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      },
      "MaterialPageCount" : {
        "properties" : {
          "done" : {
            "description" : "Pages of this kind that have an outcome",
            "example" : 40,
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "description" : "All the pages of this kind",
            "example" : 364,
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "done", "total" ],
        "type" : "object"
      },
      "MaterialPageView" : {
        "properties" : {
          "lines" : {
            "description" : "The picture's text lines in reading order; empty for a text page",
            "items" : {
              "$ref" : "#/components/schemas/PageLine"
            },
            "type" : "array"
          },
          "page" : {
            "description" : "The page's number",
            "example" : 13,
            "format" : "int32",
            "type" : "integer"
          },
          "pageTotal" : {
            "description" : "The version's page total",
            "example" : 364,
            "format" : "int32",
            "type" : "integer"
          },
          "passages" : {
            "description" : "The page's passages, in reading order",
            "items" : {
              "$ref" : "#/components/schemas/PagePassage"
            },
            "type" : "array"
          },
          "picture" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/PagePicture"
            }, {
              "type" : "null"
            } ],
            "description" : "The page's picture size (a PDF page); null for a text page, which has no picture"
          },
          "text" : {
            "description" : "A text page's text; null for a picture page",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "lines", "page", "pageTotal", "passages", "picture", "text" ],
        "type" : "object"
      },
      "MaterialPages" : {
        "properties" : {
          "done" : {
            "description" : "Pages read so far (0 until the reading stages run)",
            "example" : 0,
            "format" : "int32",
            "type" : "integer"
          },
          "image" : {
            "$ref" : "#/components/schemas/MaterialPageCount",
            "description" : "The pages found to be images only, read by OCR, and those of them with an outcome"
          },
          "readByOcr" : {
            "description" : "Pages read by OCR",
            "example" : 0,
            "format" : "int32",
            "type" : "integer"
          },
          "readDirectly" : {
            "description" : "Pages read from their text layer",
            "example" : 40,
            "format" : "int32",
            "type" : "integer"
          },
          "reading" : {
            "description" : "The layer of the pages being read now, by the step whose job is offered or running: \"text\" or \"image\"; null when none is, when those pages have no layer yet, or when their layers differ",
            "example" : "text",
            "type" : [ "string", "null" ]
          },
          "text" : {
            "$ref" : "#/components/schemas/MaterialPageCount",
            "description" : "The pages found to have a text layer, and those of them with an outcome (0 of 0 until the pages are sorted, and for a text upload)"
          },
          "total" : {
            "description" : "The version's page total",
            "example" : 320,
            "format" : "int32",
            "type" : "integer"
          },
          "unreadable" : {
            "description" : "Pages that could not be read",
            "example" : 0,
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "done", "image", "readByOcr", "readDirectly", "reading", "text", "total", "unreadable" ],
        "type" : "object"
      },
      "MaterialUpload" : {
        "properties" : {
          "expiresAt" : {
            "description" : "When the unfinished upload expires",
            "example" : "2026-11-17T06:00:00Z",
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "description" : "The upload's id: it resumes at /api/v1/uploads/{id}",
            "example" : "0190a0b0-0000-7000-8000-000000000005",
            "format" : "uuid",
            "type" : "string"
          },
          "length" : {
            "description" : "The file's size in bytes",
            "example" : 134217728,
            "format" : "int64",
            "type" : "integer"
          },
          "offset" : {
            "description" : "Bytes verified and stored",
            "example" : 67108864,
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "expiresAt", "id", "length", "offset" ],
        "type" : "object"
      },
      "Me" : {
        "properties" : {
          "username" : {
            "description" : "The username, as typed",
            "example" : "mestre_ana",
            "type" : "string"
          }
        },
        "required" : [ "username" ],
        "type" : "object"
      },
      "PageLine" : {
        "properties" : {
          "box" : {
            "description" : "The line's box, [left, top, right, bottom] as fractions of the picture from its top-left corner",
            "items" : {
              "format" : "double",
              "maximum" : 1,
              "minimum" : 0,
              "type" : "number"
            },
            "maxItems" : 4,
            "minItems" : 4,
            "type" : "array"
          },
          "text" : {
            "description" : "The line's text, as read",
            "example" : "Plate | 1,500 gp | 18",
            "type" : "string"
          }
        },
        "required" : [ "box", "text" ],
        "type" : "object"
      },
      "PagePassage" : {
        "description" : "A passage on the page: its boxes on a picture page, or its range in a text page's text",
        "properties" : {
          "boxes" : {
            "description" : "The passage's boxes, each [left, top, right, bottom] as fractions of the picture from its top-left corner",
            "items" : {
              "description" : "[left, top, right, bottom]",
              "items" : {
                "format" : "double",
                "type" : "number"
              },
              "type" : "array"
            },
            "type" : "array"
          },
          "id" : {
            "description" : "The passage's id",
            "example" : "0190a0b0-0000-7000-8000-000000000009",
            "format" : "uuid",
            "type" : "string"
          },
          "range" : {
            "description" : "The passage's range in the page's text, [start, end) in code points",
            "items" : {
              "format" : "int32",
              "type" : "integer"
            },
            "maxItems" : 2,
            "minItems" : 2,
            "type" : "array"
          }
        },
        "required" : [ "id" ],
        "type" : "object"
      },
      "PagePicture" : {
        "properties" : {
          "height" : {
            "description" : "The picture's height in pixels",
            "example" : 2000,
            "format" : "int32",
            "type" : "integer"
          },
          "width" : {
            "description" : "The picture's width in pixels",
            "example" : 1545,
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "height", "width" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "Every error of this API (RFC 9457 problem detail).",
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "code" : {
            "description" : "category.reason",
            "type" : "string"
          },
          "params" : {
            "additionalProperties" : true,
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "description" : "urn:gmshield:problem: followed by the code",
            "type" : "string"
          }
        },
        "required" : [ "category", "code", "params", "status", "title", "traceId", "type" ],
        "type" : "object"
      },
      "SessionGrant" : {
        "properties" : {
          "expiresInSeconds" : {
            "description" : "What is left of the session's absolute lifetime",
            "example" : 604800,
            "format" : "int64",
            "type" : "integer"
          },
          "renewAfterSeconds" : {
            "description" : "After this many seconds the frontend renews the token (POST /api/v1/session/renewal)",
            "example" : 900,
            "format" : "int64",
            "type" : "integer"
          },
          "sessionToken" : {
            "description" : "The session token: the frontend keeps it in a cookie and sends it as X-Session-Token",
            "example" : "example-session-token",
            "type" : "string"
          }
        },
        "required" : [ "expiresInSeconds", "renewAfterSeconds", "sessionToken" ],
        "type" : "object"
      },
      "SignInOutcome" : {
        "properties" : {
          "outcome" : {
            "description" : "signed_in: a known account, with its session; username_required: a first sign-in, whose username step comes next",
            "enum" : [ "signed_in", "username_required" ],
            "example" : "signed_in",
            "type" : "string"
          },
          "session" : {
            "$ref" : "#/components/schemas/SessionGrant",
            "description" : "Present when signed in"
          }
        },
        "required" : [ "outcome" ],
        "type" : "object"
      },
      "SignInStarted" : {
        "properties" : {
          "attemptToken" : {
            "description" : "The attempt token: the frontend keeps it in a cookie and sends it with the callback",
            "example" : "example-attempt-token",
            "type" : "string"
          },
          "authorizationUrl" : {
            "description" : "Where the browser goes next: Google's authorization endpoint, or in test mode the frontend's own callback (a path)",
            "example" : "/auth/google/callback?state=example&code=stand-in.1.gm%40example.test",
            "type" : "string"
          },
          "expiresInSeconds" : {
            "description" : "Lifetime of the attempt",
            "example" : 600,
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "attemptToken", "authorizationUrl", "expiresInSeconds" ],
        "type" : "object"
      },
      "System" : {
        "properties" : {
          "id" : {
            "description" : "The system's id",
            "example" : "0190a0b0-0000-7000-8000-000000000001",
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "description" : "The system's name",
            "example" : "Sistema sem nome",
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "UploadCompletion" : {
        "properties" : {
          "materialId" : {
            "description" : "The material's id",
            "example" : "0190a0b0-0000-7000-8000-000000000003",
            "format" : "uuid",
            "type" : "string"
          },
          "state" : {
            "description" : "The version's state",
            "example" : "waiting",
            "type" : "string"
          },
          "versionId" : {
            "description" : "The version's id",
            "example" : "0190a0b0-0000-7000-8000-000000000004",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "materialId", "state", "versionId" ],
        "type" : "object"
      },
      "UploadCompletionRequest" : {
        "properties" : {
          "sha256" : {
            "description" : "The whole file's SHA-256, in hexadecimal",
            "example" : "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "pattern" : "^[0-9a-fA-F]{64}$",
            "type" : "string"
          }
        },
        "required" : [ "sha256" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "serviceCredential" : {
        "description" : "The frontend's service credential (GMSHIELD_FRONTEND_CREDENTIAL); without it every path answers service.unauthenticated (401)",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "GMshield public API",
    "version" : "1.8.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/campaigns/current" : {
      "get" : {
        "operationId" : "getCurrentCampaign",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Campaign"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "The current campaign with its system; session.required (401) without a session, request.not_found (404) when the account has no campaign",
        "tags" : [ "library" ]
      }
    },
    "/api/v1/campaigns/{id}" : {
      "get" : {
        "operationId" : "getCampaign",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The campaign's id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Campaign"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "One of the account's campaigns, with its system; request.not_found (404) for any other id",
        "tags" : [ "library" ]
      }
    },
    "/api/v1/materials" : {
      "get" : {
        "operationId" : "listMaterials",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "A state of the newest version; repeat it for several",
          "in" : "query",
          "name" : "state",
          "required" : true,
          "schema" : {
            "items" : {
              "enum" : [ "uploading", "waiting", "processing", "needs_review", "ready", "superseded", "failed", "discarded" ],
              "type" : "string"
            },
            "minItems" : 1,
            "type" : "array"
          }
        }, {
          "description" : "At most this many, 1 to 50",
          "in" : "query",
          "name" : "limit",
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 50,
            "minimum" : 1,
            "type" : "integer"
          }
        }, {
          "description" : "The nextCursor of the previous page",
          "in" : "query",
          "name" : "cursor",
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaterialPage"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "The account's materials whose newest version is in one of the given states, newest first, with the upload's progress on those still uploading. request.invalid (400) without a state, for an unknown state, a limit outside 1 to 50 or a malformed cursor; session.required (401) without a session.",
        "tags" : [ "materials" ]
      }
    },
    "/api/v1/materials/{id}" : {
      "get" : {
        "operationId" : "getMaterial",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The material's id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Material"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "One of the account's materials, with the state of its newest version. request.not_found (404) for any other id; session.required (401) without a session.",
        "tags" : [ "materials" ]
      }
    },
    "/api/v1/materials/{id}/pages/{page}" : {
      "get" : {
        "operationId" : "getMaterialPage",
        "parameters" : [ {
          "description" : "The session token",
          "in" : "header",
          "name" : "X-Session-Token",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Why the page is read: review (the owner reviewing a version)",
          "in" : "query",
          "name" : "ground",
          "required" : true,
          "schema" : {
            "enum" : [ "review" ],
            "type" : "string"
          }
        }, {
          "description" : "The material's id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "The page's number, from 1",
          "in" : "path",
          "name" : "page",
          "required" : true,
          "schema" : {
            "format" : "int32",
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaterialPageView"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
